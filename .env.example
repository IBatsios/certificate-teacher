# Generated from docs/intake.md by kickoff v0.1.0, then extended in Task 02. A kickoff regenerate overwrites this file; re-apply the email and admin variables afterwards.
# Every variable the project needs, with a placeholder value and one comment saying where the real value comes from.
# Copy to .env and fill in. .env is ignored by git.

# From the runbook's database step (docker compose).
DATABASE_URL="postgresql://user:password@localhost:5432/teacher"

# Any long random string you generate; `pnpm dlx auth secret` writes one.
AUTH_SECRET="changeme"

# Where magic-link emails are sent from, as an SMTP URL. In development this is
# Mailpit from docker-compose.override.yml (inbox at http://localhost:8026),
# which needs no account. In
# production, any SMTP service; Resend's is smtp://resend:<api key>@smtp.resend.com:465.
EMAIL_SERVER="smtp://localhost:1025"
# The sender address on magic-link emails. In production it must be on a domain
# the SMTP service has verified.
EMAIL_FROM="Teacher <teacher@localhost>"

# The one admin. Claim it by asking for a sign-in link with this address; the
# first link creates the admin account. A password sign-up with it is refused,
# because typing an address proves nothing. Change roles afterwards on /admin/users.
ADMIN_EMAIL="you@example.com"
