# Generated from docs/intake.md by kickoff v0.1.0, then extended in Task 02. A kickoff regenerate overwrites this file; re-apply the email and admin variables afterwards.
# Every variable the project needs, with a placeholder value and one comment saying where the real value comes from.
# Copy to .env and fill in. .env is ignored by git.

# From the runbook's database step (docker compose).
DATABASE_URL="postgresql://user:password@localhost:5432/teacher"

# Any long random string you generate; `pnpm dlx auth secret` writes one.
# Production gets its own, never the development one.
AUTH_SECRET="changeme"

# Production only. The public address of the app, and permission for Auth.js
# to trust the host header behind Railway's proxy. Leave both unset in
# development; the dev server works them out.
AUTH_URL="https://teacher.example.com"
AUTH_TRUST_HOST="true"
# Production only. A long random string that a Cloudflare transform rule adds
# to every request as the X-Origin-Secret header; the app refuses requests
# without it, so nothing can reach Railway around Cloudflare. Generate with
# `openssl rand -base64 32`. Leave unset in development.
ORIGIN_SECRET="changeme"

# Production only. A Resend API key from https://resend.com/api-keys. Setting
# it switches magic-link email to Resend's HTTPS API and EMAIL_SERVER is then
# ignored. Railway disables outbound SMTP below the Pro plan, so this is the
# only route that works there (D66). Leave unset in development.
AUTH_RESEND_KEY="re_changeme"

# Where magic-link emails go when AUTH_RESEND_KEY is unset, as an SMTP URL.
# In development this is Mailpit from docker-compose.override.yml (inbox at
# http://localhost:8026), which needs no account. Note that a smtp:// URL on
# port 465 never connects: the scheme turns implicit TLS off and the port
# requires it. Use smtps://...:465 or smtp://...:587.
EMAIL_SERVER="smtp://localhost:1025"
# The sender address on magic-link emails. Both transports need it. In
# production it must be on a domain the email service has verified.
EMAIL_FROM="Teacher <teacher@localhost>"

# Any long random string you generate, as for AUTH_SECRET but a different
# one; `openssl rand -hex 32` writes one. The Docker course derives each
# student's challenge token from it (src/lib/challenge-token.ts). Tokens are
# never stored, so changing the key changes every student's token, and a
# student mid-course would have to rebuild their image with the new one.
# Needed in every environment. Production gets its own, never the
# development one.
CHALLENGE_TOKEN_KEY="changeme"

# The one admin. Claim it by asking for a sign-in link with this address; the
# first link creates the admin account. A password sign-up with it is refused,
# because typing an address proves nothing. Change roles afterwards on /admin/users.
ADMIN_EMAIL="you@example.com"
