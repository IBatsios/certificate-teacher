// Prisma schema. The database URL lives in prisma7.config.ts (read from .env).
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Who a signed-in person is: a student works through the lessons and takes the
// test; the admin sees everyone's progress and manages roles.
enum Role {
  student
  admin
}

// A person who has signed up. The Auth.js fields (name, emailVerified, image)
// are kept as the adapter expects them. passwordHash is set only for people
// who chose email and password; magic-link users never have one.
model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  role             Role              @default(student)
  passwordHash     String?
  createdAt        DateTime          @default(now())
  accounts         Account[]
  sessions         Session[]
  testAttempts     TestAttempt[]
  learningSessions LearningSession[]
}

// Auth.js: a sign-in method linked to a user. Unused until an OAuth provider
// is added, but the adapter expects the model.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Auth.js: database sessions. Sessions are JSON web tokens in this app (see
// docs/DECISIONS.md), so this table stays empty; it is here so the adapter's
// full contract is satisfied and switching strategies later needs no migration.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth.js: the one-time token behind a magic link.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// One submission of the test by a signed-in student.
model TestAttempt {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The run the attempt belongs to. Optional because attempts recorded before
  // Task 06 belong to no session, and inventing one for them would be a lie;
  // a required column here would also fail the migration wherever such rows
  // already exist.
  sessionId  String?
  session    LearningSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  passed     Boolean
  // The score as it was judged at the time. Kept rather than recomputed, so an
  // old attempt still reads the same after the questions or the pass mark
  // change. Defaulted for the rows that predate them.
  correct    Int              @default(0)
  total      Int              @default(0)
  // Topic ids not passed, in the order they were asked. Empty on a pass.
  focusAreas String[]
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([sessionId, createdAt])
}

// A student's run through the lessons, named to stay clear of Auth.js's
// Session. One is active per student at a time; "start over" archives it and
// begins another. Sessions are never deleted by the app (see D33).
enum SessionStatus {
  active
  archived
}

model LearningSession {
  id           String                  @id @default(cuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       SessionStatus           @default(active)
  startedAt    DateTime                @default(now())
  archivedAt   DateTime?
  steps        StepProgress[]
  submissions  CertificateSubmission[]
  testAttempts TestAttempt[]

  @@index([userId, status])
}

// One lesson step a student has ticked done in a session. The step keys come
// from the lesson content under content/lessons, not from the database.
model StepProgress {
  id        String          @id @default(cuid())
  sessionId String
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepKey   String
  doneAt    DateTime        @default(now())

  @@unique([sessionId, stepKey])
}

// The verdict on one certificate a student submitted for checking. Only the
// certificate is kept: it is public by nature, unlike the private key beside
// it, which the app refuses and never stores. The parsed fields are written
// down at submission time so an old submission still reads the same later,
// even if the checks change.
enum CertificateVerdict {
  passed
  failed
}

model CertificateSubmission {
  id             String             @id @default(cuid())
  sessionId      String
  session        LearningSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // The leaf, as PEM. The root is checked but not kept: it is the leaf that
  // the student was asked to produce.
  certificatePem String
  subject        String
  issuer         String
  notBefore      DateTime
  notAfter       DateTime
  verdict        CertificateVerdict
  // Which named checks failed, in the order they are shown. Empty when passed.
  failedChecks   String[]
  createdAt      DateTime           @default(now())

  @@index([sessionId, createdAt])
}
